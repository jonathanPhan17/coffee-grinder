# All values here are build-time PUBLIC config (baked into the bundle — every
# browser sees them, none are secrets), filled from the backend stack outputs.
# Copy to .env.local and fill in. Leaving all VITE_AUTH_* vars unset runs the
# app in auth-disabled dev mode (no sign-in, requests go out without a token).

# API Gateway base URL.
VITE_API_URL=

# Cognito user-pool OIDC issuer: https://cognito-idp.<region>.amazonaws.com/<poolId>
VITE_AUTH_AUTHORITY=

# Cognito user-pool app-client id.
VITE_AUTH_CLIENT_ID=

# Cognito hosted-UI base URL, e.g. https://coffeegrinder-dev.auth.us-west-1.amazoncognito.com
VITE_AUTH_DOMAIN=
